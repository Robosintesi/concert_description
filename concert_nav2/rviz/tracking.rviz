Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /TF1
        - /Map1
        - /ArUco pose1
      Splitter Ratio: 0.5
  - Class: rviz_common/Views
    Name: Views

Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Plane: XY
      Plane Cell Count: 30
      Reference Frame: <Fixed Frame>
      Value: true

    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Marker Scale: 1
      Show Names: true
      Show Axes: true
      Show Arrows: false
      Frame Timeout: 15
      Value: true

    - Alpha: 0.7
      Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Topic:
        Value: /map
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Color Scheme: map
      Draw Behind: true
      Value: true

    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Alpha: 1
      Value: true

    - Class: rviz_default_plugins/PoseWithCovariance
      Name: ArUco pose
      Enabled: true
      Topic:
        Value: /aruco/pose
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Color: 255; 25; 0
      Covariance:
        Position:
          Alpha: 0.3
          Color: 204; 51; 204
          Scale: 1
        Orientation:
          Alpha: 0.5
          Color: 255; 255; 127
          Scale: 1
        Value: true
      Shape: Arrow
      Axes Length: 0.4
      Axes Radius: 0.05
      Value: true

    - Class: rviz_default_plugins/Camera
      Name: Camera front
      Enabled: false
      Topic:
        Value: /D435i_camera_front/color/image_raw
        Durability Policy: Volatile
        Reliability Policy: Best Effort
      Value: false

    - Class: rviz_default_plugins/Camera
      Name: Camera back
      Enabled: false
      Topic:
        Value: /D435i_camera_back/color/image_raw
        Durability Policy: Volatile
        Reliability Policy: Best Effort
      Value: false

  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure

  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: TopDown (map)
      Target Frame: map
      Scale: 40
      Angle: 0
      X: 5
      Y: -4.5
    Saved: ~

Window Geometry:
  Height: 900
  Width: 1400
  Displays:
    collapsed: false
