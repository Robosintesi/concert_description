<?xml version="1.0" ?>
<sdf version="1.6">
  	<world name="tracking_piano_zero">
		<physics name="1ms" type="ignored">
			<max_step_size>0.001</max_step_size>
			<real_time_factor>1.0</real_time_factor>
		</physics>
		<plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
		<plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
			<render_engine>ogre2</render_engine>
		</plugin>
		<plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
		<plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
		<plugin filename="xbot2_gz_clock" name="gz::sim::systems::GzClockPlugin"/>

		<light type="directional" name="sun">
			<cast_shadows>true</cast_shadows>
			<pose>0 0 10 0 0 0</pose>
			<diffuse>0.9 0.9 0.9 1</diffuse>
			<specular>0.2 0.2 0.2 1</specular>
			<attenuation><range>1000</range><constant>0.9</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
			<direction>-0.5 0.1 -0.9</direction>
		</light>
		
		<scene>
			<ambient>0.6 0.6 0.6 1</ambient>
			<background>0.7 0.7 0.7 1</background>
		</scene>

		<!-- Magrone: empty ground plane -->
		<model name="magrone">
			<static>true</static>
			<link name="link">
				<collision name="collision">
					<geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
				</collision>
				<visual name="visual">
					<geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
					<material><ambient>0.6 0.58 0.55 1</ambient><diffuse>0.6 0.58 0.55 1</diffuse></material>
				</visual>
			</link>
		</model>

		<include><uri>model://aruco/marker_0</uri><pose>5.600 6.500 0 0 0 3.1416</pose></include>
		<include><uri>model://aruco/marker_1</uri><pose>-3.300 4.100 0 0 0 -1.5708</pose></include>
		<include><uri>model://aruco/marker_2</uri><pose>3.100 4.200 0 0 0 -1.5708</pose></include>
		<include><uri>model://aruco/marker_3</uri><pose>11.100 3.700 0 0 0 1.5708</pose></include>
		<include><uri>model://aruco/marker_4</uri><pose>5.800 1.000 0 0 0 0.0000</pose></include>
		<!-- <include><uri>model://aruco/marker_5</uri><pose>5.500 3.000 0 0 0 -1.5708</pose></include> -->

		<gui fullscreen="0">
			<camera name="user_camera">
				<pose>5 -20 14 0 0.5 1.5708</pose>
				<view_controller>orbit</view_controller>
			</camera>
		</gui>
  	</world>
</sdf>